{
  "provider": "kilo-free",
  "model": "cohere/north-mini-code:free",
  "max_tool_call_iterations": 500,
  "api_timeout_seconds": 300,
  "approve": {
    "all": true,
    "file_edit": true,
    "file_delete": true,
    "file_truncate": true,
    "execution": true,
    "git_commit": true,
    "git_push": false,
    "tools": {
      "run_checks": true,
      "edit_file": true,
      "os_command": false
    }
  },
  "commit_message": {
    "provider": "",
    "model": "",
    "enabled": true,
    "pattern": "{type}: {summary} {changes}",
    "prompt": "Generate a concise, conventional commit message for the following changes.\\nFollow the format: <type>: <summary>\\n\\nTypes: feat, fix, docs, test, chore, refactor, style, perf, ci, build\\n\\n{diff_section}\\nReturn only the commit message, nothing else."
  },
  "tool_safeguards": {
    "duplicate_call_detection": true,
    "duplicate_call_limit": 5,
    "repeat_call_warning": true,
    "repeat_call_warning_after": 5,
    "run_checks_timeout_seconds": 120,
    "git_status_timeout_seconds": 15,
    "git_diff_timeout_seconds": 15
  },
  "retry": {
    "enabled": true,
    "max_retries": 10,
    "initial_backoff_seconds": 5.0,
    "backoff_multiplier": 2.0,
    "max_backoff_seconds": 600.0,
    "jitter": true,
    "jitter_fraction": 0.2,
    "retry_network_errors": true,
    "retry_http_statuses": [
      408,
      425,
      429,
      500,
      502,
      503,
      504
    ],
    "retry_invalid_json": true,
    "invalid_tool_selection_enabled": true,
    "invalid_tool_selection_max_attempts": 5,
    "invalid_tool_call_recovery": {
      "enabled": true,
      "max_recovery_attempts": 5,
      "repair_conversation_history": true,
      "preserve_user_request": true,
      "stop_on_repeated_failure": false,
      "max_tool_result_chars": 12000
    }
  },
  "test_execution": {
    "timeout_seconds": 120,
    "max_output_bytes": 65536,
    "max_stdout_bytes": 49152,
    "max_stderr_bytes": 16384,
    "preserve_output_head_bytes": 4096,
    "preserve_output_tail_bytes": 8192,
    "terminate_child_processes": true
  },
  "logging": {
    "enabled": true,
    "log_dir": "logs",
    "log_file": "shai.log",
    "log_level": "DEBUG",
    "per_run_file": true,
    "newest_first": true,
    "retain_files": 10,
    "enable_console": false
  },
  "backup_cleanup": {
    "enabled": true,
    "retention_days": 1
  },
  "file_change_display": {
    "enabled": true,
    "max_diff_lines": 160,
    "max_diff_chars": 16000,
    "preserve_head_lines": 90,
    "preserve_tail_lines": 40
  },
  "agent_safeguards": {
    "enabled": true,
    "max_history_chars": 90000,
    "max_tool_result_chars": 8000,
    "keep_recent_turns": 4,
    "max_recent_tool_cycles": 6,
    "max_consecutive_no_progress_iterations": 5,
    "max_tool_calls_per_request": 500,
    "validate_tool_arguments": true,
    "reject_unknown_tool_arguments": true,
    "max_invalid_argument_attempts_per_tool": 5,
    "default_read_file_lines": 100,
    "max_read_file_lines": 500,
    "max_read_file_chars": 4000,
    "deduplicate_read_file_calls": true
  },
  "tool_call_display": {
    "show_parameters": true,
    "max_argument_chars": 2000
  },
  "reasoning_display": {
    "enabled": true,
    "max_chars": 6000
  },
  "model_context_windows": {
    "gemini::gemini-3.5-flash": 1048576,
    "gemini::gemini-3.8-flash": 1048576,
    "kilo-free::cohere/north-mini-code:free": 256000,
    "kilo-free::dots-studio/dots-3-note-preview:free": 512000,
    "kilo-free::nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free": 256000,
    "kilo-free::nvidia/nemotron-3-ultra-550b-a55b:free": 1000000,
    "openrouter::liquid/lfm-2.5-2.6b:free": 65536,
    "openrouter::nvidia/nemotron-3-ultra-550b-a55b:free": 1000000
  },
  "context_window_tokens": 256000,
  "providers": {
    "openrouter": {
      "url": "https://openrouter.ai/api/v1/chat/completions",
      "models_url": "https://openrouter.ai/api/v1/models",
      "key_env": "OPENROUTER_API_KEY",
      "format": "openai",
      "auth_type": "bearer",
      "headers": {
        "HTTP-Referer": "https://openrouter.ai/",
        "X-Title": "Shai"
      }
    },
    "gemini": {
      "url": "https://generativelanguage.googleapis.com/v1beta/openai/chat/completions",
      "models_url": "https://generativelanguage.googleapis.com/v1beta/models",
      "key_env": "GEMINI_API_KEY",
      "format": "openai",
      "auth_type": "query",
      "auth_query_param": "key"
    },
    "anthropic": {
      "url": "https://api.anthropic.com/v1/messages",
      "models_url": "https://api.anthropic.com/v1/models?limit=1000",
      "key_env": "ANTHROPIC_API_KEY",
      "format": "anthropic",
      "auth_type": "header",
      "auth_header": "x-api-key",
      "headers": {
        "anthropic-version": "2023-06-01"
      }
    },
    "openai": {
      "url": "https://api.openai.com/v1/chat/completions",
      "models_url": "https://api.openai.com/v1/models",
      "key_env": "OPENAI_API_KEY",
      "format": "openai",
      "auth_type": "bearer"
    },
    "kilo": {
      "url": "https://ai-gateway.kilo.ai/api/v1/chat/completions",
      "models_url": "https://ai-gateway.kilo.ai/api/v1/models",
      "key_env": "KILO_API_KEY",
      "format": "openai",
      "auth_type": "bearer",
      "models_filter": "exclude_free"
    },
    "kilo-free": {
      "url": "https://ai-gateway.kilo.ai/api/v1/chat/completions",
      "models_url": "https://ai-gateway.kilo.ai/api/v1/models",
      "key_env": "KILO_API_KEY",
      "format": "openai",
      "auth_type": "bearer",
      "models_filter": "free_only"
    },
    "ollama": {
      "base_url": "http://127.0.0.1:11434/v1",
      "url": "http://127.0.0.1:11434/v1/chat/completions",
      "models_url": "http://127.0.0.1:11434/api/tags",
      "format": "openai",
      "auth_type": "none",
      "key_env": null,
      "models_filter": "ollama",
      "timeout_seconds": 300
    }
  },
  "shai_command": {
    "enabled": true
  },
  "os_command": {
    "enabled": true,
    "default_timeout_seconds": 30,
    "max_timeout_seconds": 120,
    "max_stdout_bytes": 24576,
    "max_stderr_bytes": 8192,
    "preserve_output_head_bytes": 4096,
    "preserve_output_tail_bytes": 4096,
    "terminate_child_processes": true,
    "commands": {
      "git": {
        "enabled": true,
        "subcommands": [
          "status",
          "diff",
          "log",
          "branch",
          "rev-parse",
          "show"
        ],
        "requires_approval": false,
        "allow_unrestricted": false,
        "forbidden_options": [
          "-c",
          "-C",
          "--config-env",
          "--exec-path",
          "--git-dir",
          "--work-tree"
        ],
        "forbidden_option_prefixes": [
          "--config-env=",
          "--git-dir=",
          "--work-tree="
        ],
        "injected_global_options": [
          "-c",
          "safe.directory=${PROJECT_ROOT}",
          "-c",
          "core.fsmonitor=false",
          "-c",
          "core.pager=cat"
        ],
        "injected_subcommand_options": {
          "diff": [
            "--no-ext-diff",
            "--no-textconv"
          ],
          "show": [
            "--no-ext-diff",
            "--no-textconv"
          ]
        },
        "argument_rules": {
          "status": {
            "allowed_args": [
              "--short",
              "--branch",
              "--porcelain",
              "--untracked-files=no",
              "--untracked-files=normal"
            ]
          },
          "diff": {
            "allowed_args": [
              "--stat",
              "--name-only",
              "--name-status",
              "--cached",
              "--staged",
              "--check",
              "--no-ext-diff",
              "--no-textconv",
              "--color=never"
            ],
            "allow_project_paths_after_separator": true,
            "require_any": [
              "--stat",
              "--name-only",
              "--name-status",
              "--check",
              "<path>"
            ],
            "require_any_message": "git diff must use a summary option or an explicit safe path after --."
          },
          "log": {
            "allowed_args": [
              "--oneline",
              "--decorate",
              "--no-decorate",
              "--pretty=oneline",
              "--pretty=short",
              "--pretty=fuller",
              "--format=short",
              "--format=fuller",
              "--pretty=format:%h %s",
              "--pretty=format:%H %s",
              "--format=%h %s",
              "--format=%H %s"
            ],
            "numeric_options": [
              "-n",
              "--max-count"
            ],
            "max_numeric_value": 1000,
            "patterns": [
              "--pretty=format:%(?:h|H) %s",
              "--format=%(?:h|H) %s"
            ],
            "numeric_patterns": [
              {
                "pattern": "-[1-9][0-9]{0,3}",
                "max": 1000
              },
              {
                "pattern": "--max-count=[1-9][0-9]{0,3}",
                "max": 1000
              }
            ]
          },
          "branch": {
            "allowed_args": [
              "--show-current"
            ]
          },
          "rev-parse": {
            "allowed_args": [
              "--show-toplevel",
              "--is-inside-work-tree",
              "--short",
              "HEAD"
            ]
          },
          "show": {
            "allowed_args": [
              "--stat",
              "--oneline",
              "--no-patch",
              "HEAD"
            ],
            "positional_patterns": [
              "HEAD~[0-9]{1,4}"
            ],
            "require_any": [
              "--stat",
              "--oneline",
              "--no-patch"
            ],
            "require_any_message": "git show is limited to metadata/summary output; add --stat, --oneline or --no-patch."
          }
        },
        "blocked_subcommands": [
          "daemon",
          "filter-branch"
        ],
        "forbidden_argument_patterns": [],
        "approved_commands": [],
        "approved_subcommands": []
      },
      "python3": {
        "enabled": true,
        "modules": [
          "pytest",
          "unittest",
          "compileall"
        ],
        "requires_approval": true
      }
    }
  }
}
