{
  "shai_command": {
    "enabled": true
  },
  "os_command": {
    "enabled": true,
    "default_timeout_seconds": 30,
    "max_timeout_seconds": 120,
    "max_stdout_bytes": 24576,
    "max_stderr_bytes": 8192,
    "preserve_output_head_bytes": 4096,
    "preserve_output_tail_bytes": 4096,
    "terminate_child_processes": true,
    "commands": {
      "git": {
        "enabled": true,
        "subcommands": [
          "status",
          "diff",
          "log",
          "branch",
          "rev-parse",
          "show"
        ],
        "requires_approval": false,
        "allow_unrestricted": false,
        "forbidden_options": [
          "-c",
          "-C",
          "--config-env",
          "--exec-path",
          "--git-dir",
          "--work-tree"
        ],
        "forbidden_option_prefixes": [
          "--config-env=",
          "--git-dir=",
          "--work-tree="
        ],
        "injected_global_options": [
          "-c",
          "safe.directory=${PROJECT_ROOT}",
          "-c",
          "core.fsmonitor=false",
          "-c",
          "core.pager=cat"
        ],
        "injected_subcommand_options": {
          "diff": [
            "--no-ext-diff",
            "--no-textconv"
          ],
          "show": [
            "--no-ext-diff",
            "--no-textconv"
          ]
        },
        "argument_rules": {
          "status": {
            "allowed_args": [
              "--short",
              "--branch",
              "--porcelain",
              "--untracked-files=no",
              "--untracked-files=normal"
            ]
          },
          "diff": {
            "allowed_args": [
              "--stat",
              "--name-only",
              "--name-status",
              "--cached",
              "--staged",
              "--check",
              "--no-ext-diff",
              "--no-textconv",
              "--color=never"
            ],
            "allow_project_paths_after_separator": true,
            "require_any": [
              "--stat",
              "--name-only",
              "--name-status",
              "--check",
              "<path>"
            ],
            "require_any_message": "git diff must use a summary option or an explicit safe path after --."
          },
          "log": {
            "allowed_args": [
              "--oneline",
              "--decorate",
              "--no-decorate",
              "--pretty=oneline",
              "--pretty=short",
              "--pretty=fuller",
              "--format=short",
              "--format=fuller",
              "--pretty=format:%h %s",
              "--pretty=format:%H %s",
              "--format=%h %s",
              "--format=%H %s"
            ],
            "numeric_options": [
              "-n",
              "--max-count"
            ],
            "max_numeric_value": 1000,
            "patterns": [
              "--pretty=format:%(?:h|H) %s",
              "--format=%(?:h|H) %s"
            ],
            "numeric_patterns": [
              {
                "pattern": "-[1-9][0-9]{0,3}",
                "max": 1000
              },
              {
                "pattern": "--max-count=[1-9][0-9]{0,3}",
                "max": 1000
              }
            ]
          },
          "branch": {
            "allowed_args": [
              "--show-current"
            ]
          },
          "rev-parse": {
            "allowed_args": [
              "--show-toplevel",
              "--is-inside-work-tree",
              "--short",
              "HEAD"
            ]
          },
          "show": {
            "allowed_args": [
              "--stat",
              "--oneline",
              "--no-patch",
              "HEAD"
            ],
            "positional_patterns": [
              "HEAD~[0-9]{1,4}"
            ],
            "require_any": [
              "--stat",
              "--oneline",
              "--no-patch"
            ],
            "require_any_message": "git show is limited to metadata/summary output; add --stat, --oneline or --no-patch."
          }
        },
        "blocked_subcommands": [
          "daemon",
          "filter-branch"
        ],
        "forbidden_argument_patterns": [],
        "approved_commands": [],
        "approved_subcommands": [
          "config",
          "log",
          "commit",
          "ls-files"
        ]
      },
      "python3": {
        "enabled": true,
        "modules": [
          "pytest",
          "unittest",
          "compileall"
        ],
        "requires_approval": true
      }
    }
  }
}
